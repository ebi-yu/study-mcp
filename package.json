{
  "name": "study-mcp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "mcps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:weather": "turbo run build --filter=@study-mcp/weather",
    "start:weather": "bun run mcps/weather/dist/mcps/weather/src/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.7.2",
    "typescript": "^5"
  }
}
